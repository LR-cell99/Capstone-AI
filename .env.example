# ─── LLM providers (fill in one or more) ────────────────────────────────────
# Each provider only appears in the app's sidebar if its key (or URL, for
# Ollama) is set. Leave the others empty.

# Provider selected when the app opens:
#   OpenAI | Ollama (local) | Groq | OpenRouter | Google Gemini
DEFAULT_PROVIDER=OpenAI

# OpenAI (paid) — platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# Ollama (free, runs on the same machine as the app, no key needed)
#   Install from ollama.com, then e.g.:  ollama pull qwen2.5:14b
#   Start it with a bigger context window so long resumes aren't cut off:
#     OLLAMA_CONTEXT_LENGTH=16384 ollama serve
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=qwen2.5:14b
# OLLAMA_FAST_MODEL=llama3.1:8b

# Groq (free tier, very fast) — console.groq.com/keys
GROQ_API_KEY=
# GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant

# OpenRouter (many free models, ending in ":free") — openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Google Gemini (free tier) — aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# Optional: limit which models people can pick for a provider
# (comma-separated; replaces the live model list). Useful on a shared app
# so nobody picks an expensive model on your key.
# OPENAI_MODELS=gpt-4o-mini
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free

# ─── Resume ─────────────────────────────────────────────────────────────────
# true = auto-load your resume from base_resume/ on startup.
# Keep false on any copy other people use.
AUTO_LOAD_BASE_RESUME=false

# ─── Application tracker ────────────────────────────────────────────────────
# true = keep a running history in a local file and reload it on startup.
# Keep false on a shared app (everyone would share one file).
TRACKER_AUTOSAVE=false
TRACKER_FILE=applications/applications_history.csv

# ─── Google Sheets (optional, needs: pip install gspread) ───────────────────
# One-time setup:
#  1. console.cloud.google.com -> create (or pick) a project
#  2. APIs & Services -> Library -> enable "Google Sheets API"
#  3. APIs & Services -> Credentials -> Create credentials -> Service account
#  4. Open the service account -> Keys -> Add key -> JSON -> download it
#  5. Put the file next to app.py (never commit it to GitHub) and point to it:
GOOGLE_SERVICE_ACCOUNT_FILE=google_service_account.json
#    On a host without files, paste the whole JSON on one line instead:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#  6. Share your Google Sheet with the service account's email
#     ("client_email" in the JSON) as Editor.
#
# Pre-fills your sheet link in the app. Leave empty on a shared app.
GOOGLE_SHEET_URL=
